  bucket  = aws_s3_bucket.skills.id
  key     = "skills/code-review/SKILL.md"
  content = "# Code Review Skill\n\nReview pull requests for security and style."
  etag    = md5("# Code Review Skill\n\nReview pull requests for security and style.")
