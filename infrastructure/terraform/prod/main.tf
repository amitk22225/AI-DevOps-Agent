terraform {
  required_version = ">= 1.5.0"
  required_providers {
    aws = { source = "hashicorp/aws", version = "~> 5.0" }
    awscc = { source = "hashicorp/awscc", version = "~> 1.0" }
    time = { source = "hashicorp/time", version = "~> 0.11" }
  }
  backend "s3" {
    bucket         = "prod-agents-prod-tfstate"
    key            = "prod-agents/prod/terraform.tfstate"
    region         = "us-east-1"
    dynamodb_table = "prod-agents-prod-tflock"
    encrypt        = true
  }
}

provider "aws" {
  region = var.region
  default_tags {
    tags = {
    Project = "prod-agents"
    Environment = "prod"
    ManagedBy = "agentforge"
    Team = "platform"
    CostCenter = "engineering"
    Compliance = "high"
    }
  }
}

resource "aws_vpc" "main" {
  cidr_block           = var.vpc_cidr
  enable_dns_hostnames = true
  enable_dns_support   = true
  tags = { Name = "prod-agents-prod-vpc" }
}

resource "aws_subnet" "private" {
  count             = 2
  vpc_id            = aws_vpc.main.id
  cidr_block        = cidrsubnet(var.vpc_cidr, 8, count.index + 10)
  availability_zone = data.aws_availability_zones.available.names[count.index]
  tags              = { Name = "prod-agents-prod-private-${count.index}" }
}

data "aws_availability_zones" "available" {
  state = "available"
}

resource "aws_ecs_cluster" "main" {
  name = "prod-agents-prod-cluster"
  setting {
    name  = "containerInsights"
    value = "enabled"
  }
}

resource "aws_s3_bucket" "skills" {
  bucket = "prod-agents-prod-skills"
}

resource "aws_s3_bucket_versioning" "skills" {
  bucket = aws_s3_bucket.skills.id
  versioning_configuration { status = "Enabled" }
}

resource "aws_cloudwatch_log_group" "mcp" {
  name              = "/prod-agents/prod/mcp"
  retention_in_days = 14
}

resource "aws_security_group" "agent" {
  name_prefix = "prod-agents-prod-agent-"
  vpc_id      = aws_vpc.main.id
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_iam_role" "ecs_execution" {
  name = "prod-agents-prod-ecs-execution"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = { Service = "ecs-tasks.amazonaws.com" }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "ecs_execution" {
  role       = aws_iam_role.ecs_execution.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
}

resource "aws_iam_role" "ecs_task" {
  name = "prod-agents-prod-ecs-task"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = { Service = "ecs-tasks.amazonaws.com" }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role" "agent_task" {
  name = "prod-agents-prod-agent-task"
  assume_role_policy = aws_iam_role.ecs_task.assume_role_policy
}

resource "aws_iam_role_policy" "agent_s3" {
  name = "skills-read"
  role = aws_iam_role.agent_task.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["s3:GetObject", "s3:ListBucket"]
      Resource = [aws_s3_bucket.skills.arn, "${aws_s3_bucket.skills.arn}/*"]
    }]
  })
}

resource "aws_iam_role" "lambda_mcp" {
  name = "prod-agents-prod-lambda-mcp"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = { Service = "lambda.amazonaws.com" }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_lambda_function" "browser_mcp" {
  function_name = "prod-agents-browser-mcp"
  role          = aws_iam_role.lambda_mcp.arn
  package_type  = "Image"
  image_uri     = "ghcr.io/example/browser-mcp:latest"
  timeout       = 30
  memory_size   = 512

  environment {
    variables = { MCP_PORT = "8080" }
  }

  tags = {
    Project = "prod-agents"
    Environment = "prod"
    ManagedBy = "agentforge"
    Team = "platform"
    CostCenter = "engineering"
    Compliance = "high"
  }
}
